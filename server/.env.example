# Copy to .env (git-ignored) and fill in. Only the API key is required.

# Which account bills the free tier: anthropic | openai
PROVIDER=anthropic

# Set the ONE key that matches PROVIDER. This never leaves the server.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional model override (defaults: claude-opus-4-8 for anthropic, gpt-4o-mini for openai)
# MODEL=claude-opus-4-8

# Max tokens generated per reply
MAX_TOKENS=600

# Per-IP daily budget (both reset at midnight UTC)
DAILY_REQUEST_LIMIT=20
DAILY_TOKEN_LIMIT=40000

# Optional: lock the API to your extension(s). Comma-separated chrome-extension:// origins.
# Leave empty to allow any origin.
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop

# Port (most hosts set this automatically)
PORT=8787
