# Copy to .env (git-ignored) and fill in. Only the API key is required.

# Which account bills the free tier: anthropic | openai
PROVIDER=anthropic

# Set the ONE key that matches PROVIDER. This never leaves the server.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional model override (defaults: claude-sonnet-4-6 for anthropic, gpt-4o-mini for openai).
# The free tier bills YOUR key, so prefer a cost-effective model here (Sonnet or Haiku) over
# the pricier Opus models.
# MODEL=claude-sonnet-4-6

# Max tokens generated per reply
MAX_TOKENS=600

# Per-IP daily budget (both reset at midnight UTC)
DAILY_REQUEST_LIMIT=20
DAILY_TOKEN_LIMIT=40000

# Overall daily cap across ALL IPs — the hard ceiling on what the free tier can spend per day,
# so a wave of distinct addresses can't run your key up without bound. Both reset at midnight UTC.
DAILY_GLOBAL_REQUEST_LIMIT=1000
DAILY_GLOBAL_TOKEN_LIMIT=2000000

# Port (most hosts set this automatically)
PORT=8787
